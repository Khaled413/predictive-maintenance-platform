{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "rewrites": [
        {
          "source": "/((?!api/).*)",
          "destination": "/"
        }
      ]
    },
    "ml": {
      "root": "ml",
      "runtime": "python",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": {
        "service": "ml"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
