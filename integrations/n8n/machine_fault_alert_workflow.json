        "jsCode": "// ===== EDIT THIS TABLE =====\n// key = department name EXACTLY as your website sends it\nconst engineers = {\n  'Department 1': { chatId: '10761' },\n  'Department 2': { chatId: '13161' },\n  'default':      { chatId: '131' }\n};\n// values of the \"status\" field that mean \"broken\"\nconst faultStatuses = ['fault', 'error', 'broken', 'down'];\n// ===========================\n\nconst b = $input.first().json.body || $input.first().json;\n\nconst machineName = b.machine_name || 'Unknown';\nconst machineId   = b.machine_id || '-';\nconst department  = b.department || 'default';\nconst status      = String(b.status || '').toLowerCase();\nconst fault       = b.fault || 'Not specified';\nconst time        = new Date().toLocaleString('en-GB', { timeZone: 'Africa/Cairo' });\n\nconst isFault = faultStatuses.includes(status);\nconst eng = engineers[department] || engineers['default'];\n\nconst text = `🚨 MACHINE FAULT\\nMachine: ${machineName} (ID: ${machineId})\\nDepartment: ${department}\\nFault: ${fault}\\nTime: ${time}`;\n\nreturn [{ json: { isFault, chatId: eng.chatId, text } }];"
