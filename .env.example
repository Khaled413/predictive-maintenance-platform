# Frontend API Configuration
VITE_API_URL=http://localhost:8001
ML_API_DEV_ORIGIN=http://127.0.0.1:8001

# Backend ML Service Configuration
FAILURE_THRESHOLD=0.50
HEALTH_FAILURE_WEIGHT=0.60
HEALTH_ANOMALY_WEIGHT=0.40
HEALTHY_SCORE_THRESHOLD=70
WARNING_SCORE_THRESHOLD=40

# Model Directory
MODEL_DIR=./ml/models

# Optional AI Assistant (Groq-hosted chat, vision, and transcription)
GROQ_API_KEY=
CHAT_MODEL=openai/gpt-oss-120b
VISION_MODEL=qwen/qwen3.8-27b
STT_MODEL=whisper-large-v3

# Local RAG index / multilingual embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Required in Vercel to persist indexed documents across serverless instances.
# Leave blank for local development, which uses QDRANT_PATH instead.
QDRANT_URL=
QDRANT_API_KEY=
# Optional Hugging Face token for higher hosted TTS quotas
HF_TOKEN=
