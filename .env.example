# ==============================================================================
# Industrial AI Platform - Environment Variables Template
# Copy this file to .env and fill in the values for your environment.
# ==============================================================================

# Frontend API Configuration
VITE_API_URL=http://localhost:8001
ML_API_DEV_ORIGIN=http://127.0.0.1:8001

# Supabase Authentication & Enterprise Database (Client - Public)
# Obtain these from your Supabase Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
VITE_SUPABASE_PUBLISHABLE_KEY=

# Supabase CLI / Server Secrets (Private - Never exposed to client bundle)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional n8n Fault Webhook Integration (leave blank to disable)
VITE_N8N_WEBHOOK_URL=
# Also notify on Warning status (default: false -> Critical only)
VITE_N8N_NOTIFY_WARNINGS=false

# Backend ML Service Configuration
FAILURE_THRESHOLD=0.50
HEALTH_FAILURE_WEIGHT=0.60
HEALTH_ANOMALY_WEIGHT=0.40
HEALTHY_SCORE_THRESHOLD=70
WARNING_SCORE_THRESHOLD=40

# Model Artifacts Directory
MODEL_DIR=./ml/models

# Optional AI Assistant (Groq-hosted chat, vision, and speech transcription)
GROQ_API_KEY=
CHAT_MODEL=openai/gpt-oss-120b
VISION_MODEL=qwen/qwen3.8-27b
STT_MODEL=whisper-large-v3

# Local RAG Index & Multilingual Embeddings
EMBEDDING_MODEL=intfloat/multilingual-e5-large
# Required in cloud/serverless deployments to persist vectors across instances.
# Leave blank for local development, which uses local QDRANT_PATH.
QDRANT_URL=
QDRANT_API_KEY=

# Optional Hugging Face Token for higher hosted TTS quotas
HF_TOKEN=
